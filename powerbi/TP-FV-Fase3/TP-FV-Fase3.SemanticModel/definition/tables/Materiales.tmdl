table Materiales

	column Orden
		dataType: int64
		isNameInferred
		isDataTypeInferred
		isHidden
		summarizeBy: none
		sourceColumn: [Orden]

		annotation SummarizationSetBy = Automatic

	column Material
		dataType: string
		isNameInferred
		isDataTypeInferred
		sortByColumn: Orden
		summarizeBy: none
		sourceColumn: [Material]

		annotation SummarizationSetBy = Automatic

	column 'kg por módulo'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: [kg por módulo]

		annotation SummarizationSetBy = Automatic

	column '% de la masa'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: 0.0%
		summarizeBy: sum
		sourceColumn: [% de la masa]

		annotation SummarizationSetBy = Automatic

	column 'Scrap (%)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: 0.00%
		summarizeBy: none
		sourceColumn: [Scrap (%)]

		annotation SummarizationSetBy = Automatic

	column 'Entrada (kg/h)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: [Entrada (kg/h)]

		annotation SummarizationSetBy = Automatic

	column 'Entrada (t/año)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: [Entrada (t/año)]

		annotation SummarizationSetBy = Automatic

