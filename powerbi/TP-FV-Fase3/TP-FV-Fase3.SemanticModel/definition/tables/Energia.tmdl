		annotation SummarizationSetBy = Automatic

	column Bloque
		dataType: string
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Bloque]

		annotation SummarizationSetBy = Automatic

	column 'Potencia instalada (kW)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: [Potencia instalada (kW)]

		annotation SummarizationSetBy = Automatic

	column 'Factor de carga'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: [Factor de carga]

		annotation SummarizationSetBy = Automatic

	column 'Horas de uso (h/día)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.0
		summarizeBy: none
		sourceColumn: [Horas de uso (h/día)]

		annotation SummarizationSetBy = Automatic

	column Rendimiento
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: [Rendimiento]

		annotation SummarizationSetBy = Automatic

	column 'Energía de entrada (kWh/día)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: [Energía de entrada (kWh/día)]

		annotation SummarizationSetBy = Automatic

	column 'Energía útil (kWh/día)'
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.0
		summarizeBy: sum
		sourceColumn: [Energía útil (kWh/día)]

		annotation SummarizationSetBy = Automatic

