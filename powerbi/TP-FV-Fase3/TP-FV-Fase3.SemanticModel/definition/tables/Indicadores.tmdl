table Indicadores

	column Orden
		dataType: int64
		isNameInferred
		isDataTypeInferred
		isHidden
		summarizeBy: none
		sourceColumn: [Orden]

		annotation SummarizationSetBy = Automatic

	column KPI
		dataType: string
		isNameInferred
		isDataTypeInferred
		sortByColumn: Orden
		summarizeBy: none
		sourceColumn: [KPI]

		annotation SummarizationSetBy = Automatic

	column Valor
		dataType: double
		isNameInferred
		isDataTypeInferred
		formatString: #,0.00
		summarizeBy: sum
		sourceColumn: [Valor]

		annotation SummarizationSetBy = Automatic

	column Unidad
		dataType: string
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Unidad]

		annotation SummarizationSetBy = Automatic

	column 'Base de cálculo'
		dataType: string
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Base de cálculo]

		annotation SummarizationSetBy = Automatic

	column Lectura
		dataType: string
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Lectura]

		annotation SummarizationSetBy = Automatic

	partition Indicadores = calculated
		mode: import
		source = ```
			DATATABLE(
			    "Orden", INTEGER,
			    "KPI", STRING,
			    "Valor", DOUBLE,
			    "Unidad", STRING,
			    "Base de cálculo", STRING,
			    "Lectura", STRING,
			    {
			        { 1, "Módulos por año", 185185.185185185, "mód/año", "100 MWp ÷ 540 Wp", "Capacidad de 100 MWp con módulos de 540 Wp" },
			        { 2, "Ritmo de línea", 30.2590171871218, "mód/h", "mód/año ÷ 6.120 h", "Base del dimensionamiento" },
			        { 3, "Producción anual", 5185.18518518519, "t/año", "185.185 mód × 28 kg", "185.185 módulos de 28 kg" },
			        { 4, "Potencia instalada", 479.5, "kW", "suma de placa de equipos", "Suma de placa del balance eléctrico" },
			        { 5, "Demanda máxima estimada", 359.625, "kW", "instalada × 0,75", "Factor de simultaneidad 0,75" },
			        { 6, "Energía anual", 1537.524, "MWh/año", "kWh/día × 300 días", "Proceso más servicios auxiliares" },
			        { 7, "Energía por módulo", 8.3026296, "kWh/mód", "MWh/año ÷ mód/año", "Indicador propio de la industria fotovoltaica" },
			        { 8, "Energía por tonelada", 296.522485714286, "kWh/t", "MWh/año ÷ t/año", "Producto liviano, con peso de HVAC y laminado; 15,38 MWh/MWp" },
			        { 9, "Energía por MWp", 15.37524, "MWh/MWp", "MWh/año ÷ 100 MWp", "Permite comparar con otras plantas de módulos" },
			        { 10, "Agua total", 2340.0, "m³/año", "(sanitario + reposición) × días", "Sanitario, reposición y limpieza" },
			        { 11, "Agua por tonelada", 0.451285714285714, "m³/t", "m³/año ÷ t/año", "Bajo: no hay agua de proceso" },
			        { 12, "Efluente por tonelada", 0.406157142857143, "m³/t", "agua × 90 % ÷ t/año", "Cloacal asimilable" },
			        { 13, "DQO por tonelada", 0.203078571428571, "kg/t", "DQO × efluente ÷ t/año", "Sin carga orgánica de proceso" },
			        { 14, "Emisiones de CO₂", 538.1334, "t CO₂/año", "MWh/año × factor de red", "Consumo eléctrico × factor de red" },
			        { 15, "CO₂ por tonelada", 103.78287, "kg CO₂/t", "t CO₂/año ÷ t/año", "Emisión indirecta por consumo eléctrico" },
			        { 16, "Scrap sobre producto", 0.0132678571428572, "-", "scrap ÷ masa de producto", "Vidrio roto, rebaba, recortes y celdas rotas" },
			        { 17, "Utilización del cuello de botella", 0.840528255197827, "-", "ritmo ÷ capacidad nominal", "Laminadora C-101" }
			    }
			)
			```

	annotation PBI_ResultType = Table
