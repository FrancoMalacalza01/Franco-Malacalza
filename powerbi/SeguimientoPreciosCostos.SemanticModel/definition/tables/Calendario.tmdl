table Calendario
	dataCategory: Time

	column Date
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		isKey
		formatString: General Date
		summarizeBy: none
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column 'Año'
		dataType: int64
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column NroMes
		dataType: int64
		isNameInferred
		isDataTypeInferred
		isHidden
		summarizeBy: none
		sourceColumn: [NroMes]

		annotation SummarizationSetBy = Automatic

	column Mes
		dataType: string
		isNameInferred
		isDataTypeInferred
		sortByColumn: NroMes
		summarizeBy: none
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column 'Año-Mes'
		dataType: string
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Año-Mes]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		dataType: string
		isNameInferred
		isDataTypeInferred
		summarizeBy: none
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column 'Fin de Mes'
		dataType: dateTime
		isNameInferred
		isDataTypeInferred
		formatString: General Date
		summarizeBy: none
		sourceColumn: [Fin de Mes]

		annotation SummarizationSetBy = Automatic

	partition Calendario = calculated
		mode: import
		source = ```
			VAR _inicio = DATE(2024, 1, 1)
			VAR _fin = DATE(2025, 12, 31)
			RETURN
			ADDCOLUMNS(
			    CALENDAR(_inicio, _fin),
			    "Año", YEAR([Date]),
			    "NroMes", MONTH([Date]),
			    "Mes", FORMAT([Date], "MMM"),
			    "Año-Mes", FORMAT([Date], "yyyy-MM"),
			    "Trimestre", "T" & ROUNDUP(MONTH([Date]) / 3, 0),
			    "Fin de Mes", EOMONTH([Date], 0)
			)
			```

	annotation PBI_ResultType = Table
